# ==========================================
# GIT-FROG MULTI-TARGET DEPLOYMENT ENV VARS
# ==========================================

# Public Environment Variables (Client & Server)
VITE_APP_NAME="Git-Frog Guardian"
VITE_API_BASE_URL=""
VITE_DEPLOY_MODE="docker" # Options: vercel | cloudflare | static | docker

# Server Secrets & External Integrations
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# Authentication & OAuth Credentials
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
JWT_SECRET="git-frog-jwt-secret-key-change-me"
SESSION_SECRET="git-frog-session-secret-change-me"

# Webhooks & External Services
SLACK_WEBHOOK_URL=""
DATABASE_URL="postgresql://gitfrog:password@localhost:5432/gitfrog_db"
REDIS_URL="redis://localhost:6379"
